# Estrategia diferencial diaria. Requiere una base incremental nivel 0.
CONFIGURE RETENTION POLICY TO RECOVERY WINDOW OF 14 DAYS;
CONFIGURE CONTROLFILE AUTOBACKUP ON;
RUN {
  ALLOCATE CHANNEL c1 DEVICE TYPE DISK FORMAT 'C:\oracle_backups\xe\%d_%T_%U.bkp';
  BACKUP AS COMPRESSED BACKUPSET INCREMENTAL LEVEL 1
    DATABASE
    PLUS ARCHIVELOG NOT BACKED UP 1 TIMES;
  BACKUP CURRENT CONTROLFILE FORMAT 'C:\oracle_backups\xe\control_%d_%T_%U.ctl';
  BACKUP SPFILE FORMAT 'C:\oracle_backups\xe\spfile_%d_%T_%U.bkp';
  RELEASE CHANNEL c1;
}
LIST BACKUP SUMMARY;
RESTORE DATABASE VALIDATE;

